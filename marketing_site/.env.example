# =============================================================================
# MicroFlow Pro Marketing Site — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# NEVER commit real secrets. `.env` and `.env.local` are git-ignored.
# =============================================================================

# --- Public (exposed to the browser via NEXT_PUBLIC_ prefix) -----------------

# Canonical base URL of the deployed marketing site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of the MicroFlow Pro application sign-in page.
NEXT_PUBLIC_APP_SIGN_IN_URL=https://app.example.com/sign-in

# Embeddable calendar URL for the "Book a Demo" widget (Cal.com or Calendly).
NEXT_PUBLIC_DEMO_BOOKING_URL=https://cal.com/your-org/demo?embed=true&theme=auto

# (Optional) Plausible Analytics domain — uncomment to enable.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# --- Server-only (never exposed to the browser) ------------------------------

# Supabase project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key (server-side only — DO NOT prefix with NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
