#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# =====================================
# STAFF PORTAL ADDITIONS
# =====================================

# APK files (large, build artifacts)
*.apk
*.aab
*.ipa
*.app

# Environment files - IMPORTANT: Never commit .env files with secrets!
.env
.env.local
.env.staging
.env.production
.env.*.local

# Keep the example file
!.env.example

# Supabase credentials (never commit)
supabase/.env
*.pem
*.key
.mcp.json

# Android signing (never commit)
android/key.properties
android/app/upload-keystore.jks
*.jks
*.keystore

# IDE
.vscode/
*.code-workspace

# OS
Thumbs.db
Desktop.ini

# Local database/cache
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log.*

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Heap dumps
*.hprof

# Kilo config
.kilo/

# Graphify knowledge graph (regenerable)
graphify-out/

# Claude Code local settings (machine-local, may capture shell history)
.openclaude/settings.local.json

# Android build artifacts
android/build/
android/app/build/
