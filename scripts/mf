#!/usr/bin/env bash
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  mf — MicroFlow CLI
#  Release automation, status checks, and developer tools
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

set -euo pipefail

# ── Colors ──────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ── Helpers ─────────────────────────────────────────────────
info()    { echo -e "${BLUE}ℹ${NC}  $*"; }
success() { echo -e "${GREEN}✓${NC}  $*"; }
warn()    { echo -e "${YELLOW}⚠${NC}  $*"; }
error()   { echo -e "${RED}✗${NC}  $*" >&2; }
header()  { echo -e "\n${BOLD}${CYAN}$*${NC}"; }

# ── Get current version from pubspec.yaml ──────────────────
get_version() {
  grep "^version:" pubspec.yaml | sed 's/version: //' | cut -d+ -f1
}

get_build_number() {
  grep "^version:" pubspec.yaml | sed 's/version: //' | cut -d+ -f2
}

# ── Get last git tag ──────────────────────────────────────
get_last_tag() {
  git describe --tags --abbrev=0 2>/dev/null || echo "none"
}

# ── Validate we're in a git repo ──────────────────────────
ensure_git_repo() {
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    error "Not inside a git repository"
    exit 1
  fi
}

# ── Validate we're on the development branch ──────────────
ensure_development() {
  local branch
  branch=$(git branch --show-current)
  if [ "$branch" != "development" ]; then
    warn "You're on branch '$branch', not 'development'"
    read -rp "Continue anyway? (y/N) " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
      exit 1
    fi
  fi
}

# ── Ensure working tree is clean ──────────────────────────
ensure_clean() {
  if ! git diff --quiet || ! git diff --cached --quiet; then
    error "Working tree is not clean. Commit or stash changes first."
    git status --short
    exit 1
  fi
}

# ── Bump version in pubspec.yaml ──────────────────────────
bump_version() {
  local bump_type="${1:-patch}"
  local current_version build_number

  current_version=$(get_version)
  build_number=$(get_build_number)

  IFS='.' read -r major minor patch <<< "$current_version"

  case "$bump_type" in
    major) major=$((major + 1)); minor=0; patch=0 ;;
    minor) minor=$((minor + 1)); patch=0 ;;
    patch) patch=$((patch + 1)) ;;
    *)
      error "Invalid bump type: $bump_type (use major, minor, or patch)"
      exit 1
      ;;
  esac

  local new_build=$((build_number + 1))
  local new_version="${major}.${minor}.${patch}+${new_build}"

  sed -i "s/^version: .*/version: $new_version/" pubspec.yaml
  echo "$new_version"
}

# ── Commands ──────────────────────────────────────────────

cmd_help() {
  echo -e "${BOLD}${CYAN}mf${NC} — MicroFlow CLI${NC}"
  echo ""
  echo -e "${BOLD}USAGE${NC}"
  echo "  mf <command> [options]"
  echo ""
  echo -e "${BOLD}RELEASE COMMANDS${NC}"
  echo "  mf release                       DB migrate → version bump → tag → push"
  echo "  mf staging                       Create staging tag, push"
  echo "  mf beta                          Create beta tag, push"
  echo ""
  echo -e "${BOLD}INFO COMMANDS${NC}"
  echo "  mf status                        Show current version, branch, last tag"
  echo "  mf changelog                     Show commits since last tag"
  echo "  mf secrets                       Verify GitHub Actions secrets are configured"
  echo ""
  echo -e "${BOLD}HELP${NC}"
  echo "  mf -h, mf --help                 Show this help message"
  echo ""
  echo -e "${BOLD}EXAMPLES${NC}"
  echo "  mf release                       Ask for version, run full release"
  echo "  mf staging                       Push tag v1.0.4-staging.1"
  echo "  mf beta                          Push tag v1.0.4-beta.1"
  echo "  mf status                        Show version info"
  echo "  mf changelog                     Show recent commits"
  echo ""
  echo -e "${BOLD}TAG FORMATS${NC}"
  echo "  v1.0.5           Production release (merges dev->main, full build)"
  echo "  v1.0.5-beta.1    Beta pre-release (APKs only, marked as pre-release)"
  echo "  v1.0.5-staging.1 Staging build (universal APK, no GitHub Release)"
  echo ""
}

cmd_release() {
  local bump_type="${1:-patch}"
  ensure_git_repo
  ensure_development

  header "Production Release"

  # ── Step 1: Supabase DB migration ──
  header "Step 1/3: Supabase DB Migration"
  if command -v supabase &>/dev/null; then
    supabase link --project-ref mirdnsifontxoccjwgak
    supabase db push
    success "Database migrations applied to production"
  else
    warn "Supabase CLI not installed — skipping migration"
    warn "Install: https://supabase.com/docs/guides/cli"
  fi

  # ── Step 2: Version bump, commit, tag, push ──
  header "Step 2/3: Version & Tag"

  # Auto-commit any pending changes
  if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    info "Auto-committing changes..."
    git add -A
    git commit -m "chore: pre-release changes"
    success "Changes committed"
  fi

  local current_version
  current_version=$(get_version)
  local current_build
  current_build=$(get_build_number)

  echo ""
  info "Current version: $current_version (build $current_build)"
  echo ""
  echo -e "  ${BOLD}Version format:${NC} x.y.z (e.g. 1.0.5)"
  echo -e "  ${BOLD}Build number:${NC}   auto-increments from $current_build"
  echo ""
  read -rp "Enter new version (x.y.z): " new_version

  # Validate version format
  if [[ ! "$new_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    error "Invalid version format: $new_version (use x.y.z)"
    exit 1
  fi

  # Validate version is higher
  IFS='.' read -r cur_major cur_minor cur_patch <<< "$current_version"
  IFS='.' read -r new_major new_minor new_patch <<< "$new_version"
  if [ "$new_major" -lt "$cur_major" ] || \
     ([ "$new_major" -eq "$cur_major" ] && [ "$new_minor" -lt "$cur_minor" ]) || \
     ([ "$new_major" -eq "$cur_major" ] && [ "$new_minor" -eq "$cur_minor" ] && [ "$new_patch" -le "$cur_patch" ]); then
    error "Version $new_version must be higher than current $current_version"
    exit 1
  fi

  local new_build=$((current_build + 1))
  local full_version="${new_version}+${new_build}"

  sed -i "s/^version: .*/version: $full_version/" pubspec.yaml
  success "Version updated: $current_version -> $full_version"

  local tag="v${new_version}"
  git add pubspec.yaml
  git commit -m "chore: release v$full_version"
  git tag "$tag"

  info "Pushing..."
  git push origin development
  git push origin "$tag"

  success "Tag $tag pushed"

  # ── Step 3: GitHub Actions handles the rest ──
  header "Step 3/3: GitHub Actions"
  info "Build + GitHub Release will start automatically"
  info "Track: https://github.com/sansayan01/finance_app_zo/actions"
}

cmd_staging() {
  ensure_git_repo
  ensure_development

  header "Staging Release"

  local version build_number staging_count tag
  version=$(get_version)
  build_number=$(get_build_number)

  # Count existing staging tags for this version
  staging_count=$(git tag -l "v${version}-staging.*" 2>/dev/null | wc -l)
  staging_count=$((staging_count + 1))

  tag="v${version}-staging.${staging_count}"

  info "Version: $version"
  info "Tag: $tag"

  # Auto-commit any pending changes
  if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    info "Auto-committing changes..."
    git add -A
    git commit -m "chore: staging build $tag"
    success "Changes committed"
  fi

  # Create and push tag
  git tag "$tag"
  success "Created tag: $tag"

  info "Pushing..."
  git push origin development
  git push origin "$tag"

  success "Staging $tag pushed!"
  info "Track progress: https://github.com/sansayan01/finance_app_zo/actions"
}

cmd_beta() {
  ensure_git_repo
  ensure_development

  header "Beta Pre-Release"

  local version build_number beta_count tag
  version=$(get_version)
  build_number=$(get_build_number)

  # Count existing beta tags for this version
  beta_count=$(git tag -l "v${version}-beta.*" 2>/dev/null | wc -l)
  beta_count=$((beta_count + 1))

  tag="v${version}-beta.${beta_count}"

  info "Version: $version"
  info "Tag: $tag"

  # Auto-commit any pending changes
  if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
    info "Auto-committing changes..."
    git add -A
    git commit -m "chore: beta build $tag"
    success "Changes committed"
  fi

  # Create and push tag
  git tag "$tag"
  success "Created tag: $tag"

  info "Pushing..."
  git push origin development
  git push origin "$tag"

  success "Beta $tag pushed!"
  info "Track progress: https://github.com/sansayan01/finance_app_zo/actions"
}

cmd_status() {
  ensure_git_repo

  header "MicroFlow Status"

  local version build_number branch last_tag
  version=$(get_version)
  build_number=$(get_build_number)
  branch=$(git branch --show-current)
  last_tag=$(get_last_tag)

  echo -e "  ${BOLD}Version:${NC}     $version (build $build_number)"
  echo -e "  ${BOLD}Branch:${NC}      $branch"
  echo -e "  ${BOLD}Last tag:${NC}    $last_tag"

  # Check if there are uncommitted changes
  if ! git diff --quiet; then
    warn "Uncommitted changes in working tree"
  fi

  # Check if we're ahead of remote
  local ahead
  ahead=$(git rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo "?")
  if [ "$ahead" != "0" ] && [ "$ahead" != "?" ]; then
    warn "$ahead commit(s) ahead of origin/$branch"
  fi
}

cmd_changelog() {
  ensure_git_repo

  header "Changelog since last tag"

  local last_tag
  last_tag=$(get_last_tag)

  if [ "$last_tag" = "none" ]; then
    info "No tags found. Showing all commits:"
    git log --oneline -20
  else
    info "Changes since $last_tag:"
    echo ""
    git log --oneline "${last_tag}..HEAD" 2>/dev/null || git log --oneline -20
  fi
}

cmd_secrets() {
  header "GitHub Actions Secrets Check"

  info "Checking required secrets..."
  echo ""

  local all_ok=true

  # Check if gh CLI is available
  if ! command -v gh &>/dev/null; then
    error "GitHub CLI (gh) is not installed. Install it: https://cli.github.com/"
    exit 1
  fi

  # List of required secrets
  local secrets=(
    "ANDROID_KEYSTORE_BASE64"
    "ANDROID_KEY_PROPERTIES"
    "PROD_SUPABASE_URL"
    "PROD_SUPABASE_ANON_KEY"
    "STAGING_SUPABASE_URL"
    "STAGING_SUPABASE_ANON_KEY"
    "SUPABASE_ACCESS_TOKEN"
    "POSTHOG_API_KEY"
    "POSTHOG_HOST"
    "MAPBOX_ACCESS_TOKEN"
  )

  for secret in "${secrets[@]}"; do
    if gh secret list --json name -q ".[].name" 2>/dev/null | grep -q "^${secret}$"; then
      success "$secret"
    else
      error "$secret — MISSING"
      all_ok=false
    fi
  done

  echo ""
  if [ "$all_ok" = true ]; then
    success "All secrets are configured!"
  else
    warn "Some secrets are missing. Add them at:"
    info "https://github.com/sansayan01/finance_app_zo/settings/secrets/actions"
  fi
}

# ── Main ──────────────────────────────────────────────────

main() {
  local command="${1:-help}"
  shift 2>/dev/null || true

  case "$command" in
    release)   cmd_release "$@" ;;
    staging)   cmd_staging ;;
    beta)      cmd_beta ;;
    status)    cmd_status ;;
    changelog) cmd_changelog ;;
    secrets)   cmd_secrets ;;
    -h|--help|help) cmd_help ;;
    *)
      error "Unknown command: $command"
      echo ""
      cmd_help
      exit 1
      ;;
  esac
}

main "$@"
